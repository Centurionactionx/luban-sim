{
  "name": "luban-sim",
  "version": "1.40.0",
  "description": "A collaborative, real-market-data paper-trading simulator for student teams.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Centurionactionx/luban-sim.git"
  },
  "homepage": "https://github.com/Centurionactionx/luban-sim#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "bootstrap:admin": "tsx scripts/create-admin-invitation.ts",
    "relink:clerk": "tsx scripts/relink-clerk-accounts.ts",
    "import:roster": "tsx scripts/import-roster.ts",
    "backup:db": "tsx scripts/export-database.ts",
    "changelog": "tsx scripts/write-changelog.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "@vercel/analytics": "^2.0.1",
    "d3-hierarchy": "^3.1.2",
    "motion": "^13.1.1",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.3.8",
    "@playwright/test": "^1.62.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
