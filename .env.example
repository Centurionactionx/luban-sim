# The default is "yahoo": free, keyless market quotes and chart history for
# this local prototype. Use "synthetic" only for deterministic automated tests.
LUBAN_MARKET_DATA_PROVIDER=yahoo

# Required only when running a production build as an access-controlled private
# demo. Never enable this on a public deployment: it permits identity switching,
# including access to the seeded host account.
LUBAN_DEMO_MODE=true

# Local development and automated tests are forced to SQLite even if a
# POSTGRES_URL has been pulled into the shell. Vercel Production receives the
# non-secret "postgres" selection from vercel.json; never put a database URL in
# this file.
LUBAN_DATABASE_PROVIDER=sqlite

# One-off remote migrations are refused unless this exact acknowledgement is
# supplied for that command. Leave it unset during normal development.
# LUBAN_ALLOW_REMOTE_DATABASE_MIGRATION=I_UNDERSTAND_THIS_TOUCHES_REMOTE
