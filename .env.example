# The default is "yahoo": free, keyless market quotes and chart history for
# this local prototype. Use "synthetic" only for deterministic automated tests.
LUBAN_MARKET_DATA_PROVIDER=yahoo

# Authentication mode.
#   demo    (default) — seeded identities with the local identity switcher.
#   managed           — real registration/sign-in through Clerk. Requires the
#                       Clerk keys below and disables demo identity switching.
# LUBAN_AUTH_MODE=managed

# Required only when running a production build as an access-controlled private
# demo. Never enable this on a public deployment: it permits identity switching,
# including access to the seeded host account.
# LUBAN_DEMO_MODE=true

# ── Managed mode (LUBAN_AUTH_MODE=managed) ────────────────────────────────
# Create a Clerk application (https://dashboard.clerk.com), then copy its keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# One-time escape hatch for deployments where the bootstrap script cannot be
# run: the first sign-in whose *verified* email matches becomes the first
# platform administrator, but only while no platform administrator exists.
# Remove the variable afterwards. Prefer: pnpm bootstrap:admin -- --email ...
# LUBAN_BOOTSTRAP_ADMIN_EMAIL=admin@example.ca

# Hosts and platform administrators must have multi-factor authentication
# enrolled before host controls unlock (checked server-side against Clerk).
# Set to false only while your Clerk plan cannot enable MFA strategies yet.
# LUBAN_REQUIRE_ADMIN_MFA=true

# Base URL used by `pnpm bootstrap:admin` when printing invitation links.
# LUBAN_APP_URL=http://localhost:3000

# Anti-spam ceiling on order attempts per student per rolling minute.
# The default (20) sustains real day trading — an order every three seconds —
# while stopping runaway scripts. Raise or lower per event size.
# LUBAN_MAX_ORDERS_PER_MINUTE=20

# Oldest market quote (minutes) an order may fill against. Competition orders
# are also refused outside each exchange's regular session. The default (20)
# sits just above the ~15-minute delay of free TSX data.
# LUBAN_MAX_QUOTE_AGE_MINUTES=20

# ── Asset classes ─────────────────────────────────────────────────────────
# Stocks are always on. ETFs and crypto are off unless set to exactly "true".
# Adding them changes the contest rules: email participants before turning
# either on in Production (see DEPLOYMENT.md). Turning one off again stops new
# buys only; existing holdings can still be sold.
#
# ETFs on NYSE, NYSE Arca, NYSE American, NASDAQ, Cboe BZX and TSX trade like
# stocks (exchange hours, whole shares). Leveraged and inverse ETFs stay
# excluded.
# LUBAN_ENABLE_ETFS=true
#
# Crypto pairs Yahoo Finance quotes in CAD or USD, traded 24/7 in fixed lots.
# LUBAN_ENABLE_CRYPTO=true
#
# Minimum 24-hour trading volume a crypto pair needs to be added or traded
# (default 250000). Pairs also need a price from the last 10 minutes and four
# hours of recent history.
# LUBAN_CRYPTO_MIN_VOLUME=250000

# Comma-separated symbols pulled from the simulator, e.g. a coin or fund that
# misbehaves. Blocked symbols can't be found or bought; existing holdings can
# still be sold. Blocking one pair of a coin also blocks its other pair
# (DOGE-USD blocks DOGE-CAD). Changing this needs a redeploy.
# LUBAN_BLOCKED_SYMBOLS=DOGE-USD,PEPE24478-USD

# ── Database ──────────────────────────────────────────────────────────────
# Default: SQLite at data/luban.sqlite (zero setup; resets on serverless).
# For a durable deployment set BOTH of these — the provider switch is always
# explicit, so stray credentials alone never open a remote connection:
# LUBAN_DATABASE_PROVIDER=postgres
# LUBAN_DATABASE_URL=postgres://user:pass@host:6543/postgres
# (LUBAN_DATABASE_URL falls back to POSTGRES_URL, which the Supabase Vercel
#  integration sets automatically. Use the pooled/transaction-mode URL.)
# TLS certificates are verified for remote databases. If the provider uses a
# private CA, set LUBAN_DATABASE_CA_CERT to its PEM certificate, or include
# sslrootcert=/absolute/path/to/provider-ca.pem in the connection URL.
# LUBAN_DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
#
# PostgreSQL connections per server process (default 10, max 50). Keep
# running instances x this value within your pooler's client limit.
# LUBAN_DATABASE_POOL_MAX=10

# Anti-spam ceiling on invitations created per host/admin per rolling minute.
# The default (30) is generous for real onboarding and stops a compromised
# host account from flooding the table or blasting invitation emails.
# LUBAN_MAX_INVITATIONS_PER_MINUTE=30
